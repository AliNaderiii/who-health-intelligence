# WHO Global Health Intelligence Platform - Environment Variables Example
# Copy this file to .env and set values as needed. Do not commit .env with secrets.

# ------------------------------------------------------------------
# Data Mode - explicit LIVE vs DEMO
# ------------------------------------------------------------------
# Default deployment mode must be LIVE. DEMO requires explicit setting.
WHO_DATA_MODE=live
# For local dev/testing only: set to demo to use synthetic bootstrap data
# WHO_DATA_MODE=demo

# ------------------------------------------------------------------
# WHO API Configuration
# ------------------------------------------------------------------
# Currently working endpoint (validated). Configurable for forward compat.
# Official docs: https://www.who.int/data/gho/info/gho-odata-api
WHO_API_BASE_URL=https://ghoapi.azureedge.net/api/
WHO_API_TIMEOUT=30
WHO_API_MAX_RETRIES=3
WHO_REFRESH_TTL=3600

# ------------------------------------------------------------------
# Dashboard startup behaviour
# ------------------------------------------------------------------
# The dashboard never runs the ETL pipeline at import time. It renders its shell
# and status panel first, then the controlled loader runs.
# When LIVE mode starts with no local snapshot (the normal case on Streamlit
# Community Cloud, where the filesystem is ephemeral), the loader performs one
# real WHO API extraction. Set to false to disable that first-run extraction and
# rely exclusively on an existing snapshot / the Refresh Data button.
# A failed extraction is reported as LIVE DATA UNAVAILABLE - synthetic data is
# never substituted.
WHO_AUTO_BOOTSTRAP=true

# Legacy aliases (still supported):
# WHO_REQUEST_TIMEOUT=30
# WHO_RETRY_COUNT=3
# WHO_RETRY_BACKOFF_BASE=2

# ------------------------------------------------------------------
# Database Path
# ------------------------------------------------------------------
# SQLite path - not persistent on Streamlit Cloud, see README for production storage options
WHO_DB_PATH=data/who_health_data.db
WHO_DATA_DIR=data/
WHO_RAW_DATA_PATH=data/raw/
WHO_PROCESSED_DATA_PATH=data/processed/
WHO_METADATA_PATH=data/metadata/
WHO_REPORTS_DIR=reports/

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
LOG_LEVEL=INFO
WHO_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ------------------------------------------------------------------
# Project Version
# ------------------------------------------------------------------
WHO_PROJECT_VERSION=4.0.0

# ------------------------------------------------------------------
# Streamlit Cloud Notes
# ------------------------------------------------------------------
# - Python runtime is pinned to 3.12 via runtime.txt and .python-version
# - No secrets required for public WHO GHO OData API
# - Local SQLite not persistent on Streamlit Community Cloud
# - For production persistent storage consider:
#   PostgreSQL, Supabase, S3-compatible object storage, managed database
# - For current Streamlit deployment, real API snapshot with extraction timestamp is shown
# - Set WHO_DATA_MODE=live (default) in Streamlit Cloud secrets/env

# ------------------------------------------------------------------
# Optional: Bootstrap (DEMO only)
# ------------------------------------------------------------------
# The bootstrap script generates synthetic data for development/testing:
# python scripts/bootstrap_data.py
# This should ONLY be used when WHO_DATA_MODE=demo
